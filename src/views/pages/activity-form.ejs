<%- include("../partials/header", { pageTitle }) %>

<h1>Ajouter une activité</h1>

<form action="/activities" method="POST">
    <div>
        <label for="name">Nom</label>
        <input
            type="text"
            id="name"
            name="name"
            required
        >
    </div>

    <div>
        <label for="description">Description</label>
        <textarea
            id="description"
            name="description"
        ></textarea>
    </div>

    <div>
        <label for="sport">Sport</label>
        <input
            type="text"
            id="sport"
            name="sport"
            required
        >
    </div>

    <div>
        <label for="min_age">Âge minimum</label>
        <input
            type="number"
            id="min_age"
            name="min_age"
            min="0"
            required
        >
    </div>

    <div>
        <label for="max_age">Âge maximum</label>
        <input
            type="number"
            id="max_age"
            name="max_age"
            min="0"
            required
        >
    </div>

    <div>
        <label for="base_price">Prix</label>
        <input
            type="number"
            id="base_price"
            name="base_price"
            min="0"
            step="0.01"
            required
        >
    </div>

    <div>
        <label>
            <input
                type="checkbox"
                name="medical_certificate_required"
            >
            Certificat médical obligatoire
        </label>
    </div>

    <button type="submit">Enregistrer</button>
</form>

<a href="/activities">Annuler</a>

<%- include("../partials/footer") %>