<%- include("../partials/header", { pageTitle }) %>

<a href="/activities/new">Ajouter une activité</a>

<h1>Catalogue des activités</h1>

<% if (activities.length === 0) { %>

    <p>Aucune activité disponible.</p>

<% } else { %>

    <ul>
        <% activities.forEach((activity) => { %>

            <li>
                <h2><%= activity.name %></h2>

                <p>
                    <%= activity.description || "Aucune description" %>
                </p>

                <p>
                    Sport : <%= activity.sport %>
                </p>

                <p>
                    Âge : de <%= activity.min_age %>
                    à <%= activity.max_age %> ans
                </p>

                <p>
                    Prix :
                    <%= Number(activity.base_price).toFixed(2) %>
                    MAD
                </p>

                <p>
                    Certificat médical :
                    <%= activity.medical_certificate_required
                        ? "Obligatoire"
                        : "Non obligatoire" %>
                </p>

                <a href="/activities/<%= activity.id %>/edit">
                    Modifier
                </a>

                <form
                    action="/activities/<%= activity.id %>/deactivate"
                    method="POST"
                    onsubmit="return confirm(
                        'Voulez-vous vraiment désactiver cette activité ?'
                    );"
                >
                    <button type="submit">
                        Désactiver
                    </button>
                </form>

            </li>

        <% }); %>
    </ul>

<% } %>

<a href="/">Retour à l’accueil</a>

<%- include("../partials/footer") %>